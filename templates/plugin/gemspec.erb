# coding: utf-8
lib = File.expand_path('../lib', __FILE__)
$LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)
require 'busser/<%= config[:name] %>/version'

Gem::Specification.new do |spec|
  spec.name          = '<%= config[:gem_name] %>'
  spec.version       = Busser::<%= config[:klass_name] %>::VERSION
  spec.authors       = ['<%= config[:author] %>']
  spec.email         = ['<%= config[:email] %>']
  spec.description   = %q{A Busser <%= config[:type] %> plugin for <%= config[:klass_name] %>}
  spec.summary       = spec.description
  spec.homepage      = ''
<% if config[:license_spdx] -%>
  spec.license       = '<%= config[:license_spdx] %>'
<% end -%>

  spec.files         = `git ls-files -z`.split("\x0")
  spec.executables   = []
  spec.require_paths = ['lib']

  spec.required_ruby_version = '>= 3.2'

  spec.add_dependency 'busser', '>= 0.9.0'
end
